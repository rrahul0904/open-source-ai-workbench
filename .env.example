# Optional. If unset the deployment is fully functional in deterministic demo mode.
WORKBENCH_API_KEY=
PORT=3000

# Optional OpenAI-compatible LLM provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# Optional generic connector target. Arbitrary user URLs are never fetched.
CONNECTOR_HTTP_BASE_URL=
CONNECTOR_HTTP_TOKEN=

# Optional durable persistence using Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RE-334 Evidence Lab: live model calls are OFF by default and operator-only.
COMPARE_LIVE_ENABLED=false
OPENAI_COMPARE_API_KEY=
OPENAI_COMPARE_MODEL=
ANTHROPIC_COMPARE_API_KEY=
ANTHROPIC_COMPARE_MODEL=
GEMINI_COMPARE_API_KEY=
GEMINI_COMPARE_MODEL=
DEEPSEEK_COMPARE_API_KEY=
DEEPSEEK_COMPARE_MODEL=
